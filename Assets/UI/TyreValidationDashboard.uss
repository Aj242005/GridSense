/* GridSense - Persistent Right-Side Pit-Wall Dashboard Stylesheet */

:root {
    --bg-base: #0a0e17;
    --bg-surface: rgba(14, 20, 32, 0.92);
    --bg-card: rgba(20, 29, 48, 0.85);
    --border-subtle: rgba(40, 60, 95, 0.5);
    --border-cyan: rgba(0, 210, 255, 0.4);
    --text-main: #f0f4fc;
    --text-muted: #8e9fb8;
    --accent-cyan: #00e5ff;
    --accent-green: #06d6a0;
    --accent-amber: #ffb703;
    --accent-red: #ff3366;
    
    font-size: 12px;
    color: var(--text-main);
}

/* Fullscreen Transparent Overlay (leaves center and left unobstructed) */
.screen-overlay {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: stretch;
    background-color: transparent;
    pointer-events: none;
}

/* Right-Side Telemetry Sidebar */
.dashboard-sidebar {
    width: 440px;
    max-width: 32%;
    height: 100%;
    background-color: var(--bg-surface);
    border-left-width: 1.5px;
    border-left-color: var(--border-cyan);
    display: flex;
    flex-direction: column;
    pointer-events: auto;
    overflow: hidden;
}

.sidebar-scrollview {
    width: 100%;
    height: 100%;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
}

/* Header */
.sidebar-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    margin-bottom: 10px;
}

.header-titles {
    display: flex;
    flex-direction: column;
}

.sidebar-main-title {
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 1.5px;
    color: #ffffff;
}

.sidebar-subtitle {
    font-size: 9.5px;
    letter-spacing: 1px;
    color: var(--accent-cyan);
    margin-top: 1px;
}

.header-badges {
    display: flex;
    flex-direction: row;
}

.badge {
    padding: 3px 7px;
    margin-left: 5px;
    border-radius: 3px;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 0.8px;
    background-color: #1a2744;
    color: var(--accent-cyan);
    border-width: 1px;
    border-color: #2b3f6b;
}

.badge-green {
    background-color: rgba(6, 214, 160, 0.15);
    color: var(--accent-green);
    border-color: rgba(6, 214, 160, 0.4);
}

/* Live Gauges Card */
.sidebar-gauge-card {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #0b111e;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(0, 210, 255, 0.35);
    padding: 8px 14px;
    margin-bottom: 10px;
}

.gauge-left {
    display: flex;
    flex-direction: row;
    align-items: baseline;
}

.speed-number {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 1px;
}

.speed-unit {
    font-size: 10px;
    font-weight: bold;
    color: var(--accent-cyan);
    margin-left: 6px;
    letter-spacing: 1px;
}

.gauge-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.gear-badge {
    font-size: 13px;
    font-weight: bold;
    color: var(--accent-green);
    background-color: rgba(6, 214, 160, 0.12);
    padding: 2px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(6, 214, 160, 0.3);
}

.rpm-text {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 3px;
}

/* Sections & Cards */
.sidebar-section {
    display: flex;
    flex-direction: column;
    margin-bottom: 10px;
}

.section-title {
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 5px;
}

.section-card {
    background-color: var(--bg-card);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--border-subtle);
    padding: 9px 12px;
}

.card-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.card-row-label {
    font-size: 9.5px;
    font-weight: bold;
    letter-spacing: 0.8px;
    color: var(--text-muted);
}

.card-row-value {
    font-size: 14px;
    font-weight: bold;
}

.card-subtext {
    font-size: 9.5px;
    color: var(--text-muted);
}

.card-value-medium {
    font-size: 16px;
    font-weight: bold;
    margin-top: 2px;
    margin-bottom: 2px;
}

.progress-bar-container {
    height: 6px;
    background-color: #0b111e;
    border-radius: 3px;
    margin-top: 5px;
    margin-bottom: 4px;
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    background-color: var(--accent-cyan);
    border-radius: 3px;
    width: 0%;
}

.progress-bar-fill-amber {
    background-color: var(--accent-amber);
}

.progress-bar-fill-green {
    background-color: var(--accent-green);
}

.directive-box {
    margin-top: 6px;
    padding: 5px 8px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    border-left-width: 2px;
    border-left-color: var(--accent-cyan);
}

.directive-text {
    font-size: 9.5px;
    color: #e2ecfc;
    white-space: normal;
}

/* Dual Metrics Half */
.dual-metrics-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.metric-half {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
}

.metric-half:last-child {
    margin-right: 0;
}

/* 4-Corner Tyre Grid */
.corner-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(40, 60, 95, 0.4);
}

.corner-item {
    width: 48%;
    font-size: 9px;
    color: var(--text-muted);
    margin-bottom: 3px;
}

/* Environmental Attribution Grid */
.attr-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.attr-box {
    width: 48%;
    background-color: var(--bg-card);
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--border-subtle);
    padding: 6px 8px;
    margin-bottom: 6px;
    display: flex;
    flex-direction: column;
}

.attr-box-label {
    font-size: 8.5px;
    letter-spacing: 0.6px;
    color: var(--text-muted);
    margin-bottom: 2px;
}

.attr-box-val {
    font-size: 13px;
    font-weight: bold;
}

.attr-negative {
    color: var(--accent-green);
}

.attr-positive {
    color: var(--accent-red);
}

/* Sidebar Chart Canvas */
.chart-header-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.stint-tabs-mini {
    display: flex;
    flex-direction: row;
}

.mini-tab {
    padding: 2px 7px;
    margin-left: 4px;
    border-radius: 3px;
    font-size: 9px;
    background-color: #182238;
    color: var(--text-muted);
    border-width: 1px;
    border-color: transparent;
}

.mini-tab-active {
    background-color: rgba(0, 210, 255, 0.18);
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
    font-weight: bold;
}

.chart-canvas-sidebar {
    width: 100%;
    height: 125px;
    background-color: #0b101c;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(40, 60, 95, 0.6);
}

/* Footer Hints */
.sidebar-footer {
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
    align-items: center;
    margin-top: 4px;
}

.footer-hint {
    font-size: 9px;
    color: #6a7c98;
    letter-spacing: 0.5px;
}
